struct lconv* localeconv(void)
{
    if (!riscos_c_locale_initialised)
    {
        std::memset(&riscos_c_locale, 0, sizeof(riscos_c_locale));
        riscos_c_locale.decimal_point = const_cast<char*>(".");
        riscos_c_locale.thousands_sep = const_cast<char*>("");
        riscos_c_locale.grouping = const_cast<char*>("");
        riscos_c_locale.mon_decimal_point = const_cast<char*>(".");
        riscos_c_locale.mon_thousands_sep = const_cast<char*>("");
        riscos_c_locale.mon_grouping = const_cast<char*>("");
        riscos_c_locale.positive_sign = const_cast<char*>("");
        riscos_c_locale.negative_sign = const_cast<char*>("");
        riscos_c_locale.int_frac_digits = CHAR_MAX;
        riscos_c_locale.frac_digits = CHAR_MAX;
        riscos_c_locale.p_cs_precedes = CHAR_MAX;
        riscos_c_locale.p_sep_by_space = CHAR_MAX;
        riscos_c_locale.n_cs_precedes = CHAR_MAX;
        riscos_c_locale.n_sep_by_space = CHAR_MAX;
        riscos_c_locale.p_sign_posn = CHAR_MAX;
        riscos_c_locale.n_sign_posn = CHAR_MAX;
        riscos_c_locale_initialised = true;
    }

    return &riscos_c_locale;
}

