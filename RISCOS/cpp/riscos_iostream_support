int vasprintf(char** output, const char* format, va_list args)
{
    va_list copy;
    int length;

    va_copy(copy, args);
    length = std::vsnprintf(nullptr, 0, format, copy);
    va_end(copy);
    if (length < 0)
        return -1;

    *output = static_cast<char*>(std::malloc(static_cast<size_t>(length) + 1));
    if (*output == nullptr)
        return -1;

    return std::vsnprintf(*output, static_cast<size_t>(length) + 1, format, args);
}

