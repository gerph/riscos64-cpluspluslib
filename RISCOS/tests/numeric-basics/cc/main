/*******************************************************************
 * File:        main
 * Purpose:     Numeric algorithm smoke test for the RISC OS libc++ export
 * Author:      Gerph
 ******************************************************************/

#include <array>
#include <cstdio>
#include <numeric>
#include <vector>

namespace {

bool check(bool condition, const char *message)
{
    if (!condition)
    {
        std::printf("FAIL: %s\n", message);
        return false;
    }

    return true;
}

bool test_accumulate_and_iota()
{
    std::vector<int> values(5);

    std::iota(values.begin(), values.end(), 1);

    return check(values.front() == 1, "iota front")
        && check(values.back() == 5, "iota back")
        && check(std::accumulate(values.begin(), values.end(), 0) == 15, "accumulate");
}

bool test_partial_sum()
{
    std::array<int, 5> input = {1, 2, 3, 4, 5};
    std::array<int, 5> output = {};

    std::partial_sum(input.begin(), input.end(), output.begin());

    return check(output[0] == 1, "partial_sum first")
        && check(output[2] == 6, "partial_sum middle")
        && check(output[4] == 15, "partial_sum last");
}

bool test_adjacent_difference()
{
    std::array<int, 5> input = {3, 6, 10, 15, 21};
    std::array<int, 5> output = {};

    std::adjacent_difference(input.begin(), input.end(), output.begin());

    return check(output[0] == 3, "adjacent_difference first")
        && check(output[1] == 3, "adjacent_difference second")
        && check(output[4] == 6, "adjacent_difference last");
}

bool test_inner_product()
{
    std::array<int, 3> left = {2, 3, 4};
    std::array<int, 3> right = {5, 6, 7};

    return check(std::inner_product(left.begin(), left.end(), right.begin(), 0) == 56, "inner_product");
}

bool test_gcd_lcm()
{
    return check(std::gcd(84, 30) == 6, "gcd")
        && check(std::lcm(12, 18) == 36, "lcm");
}

} // namespace

int main()
{
    bool ok = true;

    ok = test_accumulate_and_iota() && ok;
    ok = test_partial_sum() && ok;
    ok = test_adjacent_difference() && ok;
    ok = test_inner_product() && ok;
    ok = test_gcd_lcm() && ok;

    if (!ok)
        return 1;

    std::puts("libc++ numeric basics passed");
    return 0;
}
