/*******************************************************************
 * File:        main
 * Purpose:     Algorithm libc++ smoke test for the RISC OS port
 * Author:      Gerph
 ******************************************************************/

#include <algorithm>
#include <array>
#include <cstdio>
#include <iterator>
#include <numeric>
#include <vector>

namespace {

bool check(bool condition, const char *message)
{
    if (!condition)
    {
        std::printf("FAIL: %s\n", message);
        return false;
    }

    return true;
}

bool test_sorting_and_search()
{
    std::vector<int> values = {7, 2, 5, 3, 1, 4, 6};

    std::sort(values.begin(), values.end());

    return check(std::is_sorted(values.begin(), values.end()), "sort")
        && check(std::binary_search(values.begin(), values.end(), 5), "binary_search")
        && check(std::lower_bound(values.begin(), values.end(), 4) == values.begin() + 3, "lower_bound")
        && check(std::upper_bound(values.begin(), values.end(), 4) == values.begin() + 4, "upper_bound");
}

bool test_rearrangement_algorithms()
{
    std::array<int, 8> values = {1, 2, 3, 4, 5, 6, 7, 8};
    std::array<int, 8> output = {};

    auto middle = std::remove_if(values.begin(), values.end(), [](int value) { return value % 2 == 0; });
    auto copy_end = std::copy(values.begin(), middle, output.begin());
    std::reverse(output.begin(), copy_end);
    std::rotate(output.begin(), output.begin() + 1, copy_end);

    return check(std::distance(output.begin(), copy_end) == 4, "copy distance")
        && check(output[0] == 5 && output[1] == 3 && output[2] == 1 && output[3] == 7, "rotate and reverse")
        && check(std::all_of(output.begin(), copy_end, [](int value) { return value % 2 == 1; }), "odd values");
}

bool test_numeric_helpers()
{
    std::array<int, 5> values = {1, 2, 3, 4, 5};
    int sum = 0;
    std::for_each(values.begin(), values.end(), [&sum](int value) { sum += value; });

    return check(sum == 15, "for_each")
        && check(std::accumulate(values.begin(), values.end(), 0) == 15, "accumulate")
        && check(std::minmax_element(values.begin(), values.end()).first == values.begin(), "minmax_element");
}

} // namespace

int main()
{
    bool ok = true;

    ok = test_sorting_and_search() && ok;
    ok = test_rearrangement_algorithms() && ok;
    ok = test_numeric_helpers() && ok;

    if (!ok)
        return 1;

    std::puts("libc++ algorithm basics passed");
    return 0;
}
